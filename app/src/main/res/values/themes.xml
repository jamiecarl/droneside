<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Droneside" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>

    <!-- Launch theme: the splash screen, then Theme.Droneside. Before Android 12 the compat splash shows a
         still icon, so it gets the finished mark (values-v31 swaps in the animated one). -->
    <style name="Theme.Droneside.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Droneside</item>
    </style>
</resources>
