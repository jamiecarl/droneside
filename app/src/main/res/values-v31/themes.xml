<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the Lap D draws itself on launch. -->
    <style name="Theme.Droneside.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Droneside</item>
    </style>
</resources>
